# Archive-capable RPC URLs for the fork tests in test-fork/ (`npm run test:fork`).
# Hardhat does not load .env by itself: export these, store them with `npx hardhat keystore set <NAME>`,
# or run `node --env-file=.env node_modules/hardhat/dist/src/cli.js test nodejs --build-profile production test-fork/*.fork.test.ts`.
ETHEREUM_SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=

# Optional: override the pinned fork blocks (defaults live in hardhat.config.ts).
# ETHEREUM_SEPOLIA_FORK_BLOCK=
# POLYGON_AMOY_FORK_BLOCK=
